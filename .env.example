# Netlify Database / PostgreSQL
NETLIFY_DATABASE_URL=postgresql://user:pass@ep-xxx.netlify.app/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.netlify.app/dbname?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Security & KMS PII Encryption Secret
KMS_SECRET_KEY=your-32-character-kms-secret-key

# Mock Services
MOCK_OTP_CODE=888888
MOCK_GATEWAY_SECRET=mock-gateway-secret-key
MOCK_BANK_API_KEY=mock-bank-api-key
